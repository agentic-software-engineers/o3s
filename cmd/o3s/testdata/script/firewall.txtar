# Piped, the firewall lists every host with its ports, secret and who needs it, and explains its marks
exec o3s firewall
cmp stdout want.txt
! stderr .

# --json hands the hosts to a script
exec o3s firewall --json
stdout '"allowed": \['
stdout '"host": "example.com"'
stdout '"by": \['

# A word the firewall takes no action by is a usage error
! exec o3s firewall nosuch
stderr 'unknown command "nosuch" for "o3s firewall"'

-- o3s.json --
{
  "$schema": "./.devcontainer/o3s.schema.json",
  "stores": [],
  "hosts": [
    {"name": "example.com", "ports": [22, 443], "by": ["user"], "expires": "2020-01-01T00:00:00Z"},
    {"name": "api.example.com", "ports": [443], "secret": "EXAMPLE_TOKEN", "inject": ["header"], "by": ["registry.example.com/features/tool"]}
  ]
}
-- want.txt --
HOST             PORTS   CLOSES    SECRET           BY
example.com      22,443  expired                    user
api.example.com  443     for good  EXAMPLE_TOKEN !  registry.example.com/features/tool

! waits for its value: echo "$TOKEN" | o3s secret add <name>
expired: past its end time, remove these with o3s firewall prune
