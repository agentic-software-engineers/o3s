# Piped, the projects are the workspace's folders in the projects volume, the home itself left out
mkdir home
cd home
exec o3s init
exec o3s project create example/scratch
exec o3s project create gitlab.com/group/app
exec o3s project
cmp stdout $WORK/want.txt

-- want.txt --
NAME             PATH
example/scratch  /home/ubuntu/projects/github.com/example/scratch
group/app        /home/ubuntu/projects/gitlab.com/group/app
