# A new host with --for closes at the end time it gets, which the allowlist keeps in UTC
exec o3s firewall add example.com --for 1h
stdout '^Allowed example\.com:443 until .+$'
grep '"expires": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"' o3s.json

# A later end time renews the host without a question
exec o3s firewall add example.com --for 2h
stdout '^  ~ expires '

# An earlier end time narrows the rule, so it needs a yes, and --yes without a terminal
! exec o3s firewall add example.com --for 10m
stdout '^example\.com closes at .+, needed by user\.$'
stdout '^With --for 10m it closes at .+ instead\.$'
stderr 'pass --yes to apply without a terminal'

# A host that stays open needs a yes before it gets an end, naming everyone who needs it
! exec o3s firewall add example.org --for 1h
stdout '^example\.org is allowed with no end time, needed by registry\.example\.com/features/tool and user\.$'
stdout '^With --for 1h it closes at .+ for all of them\.$'
grep -count=1 '"expires"' o3s.json
exec o3s firewall add example.org --for 1h --yes
grep -count=2 '"expires"' o3s.json

# Seconds alone and Go's durations both read as a time, and anything else is a usage error
exec o3s firewall add example.net --for 90
exec o3s firewall add example.edu --for 1h30m
! exec o3s firewall add example.com --for soon
stderr 'invalid duration "soon"'
stderr 'Run ''o3s firewall add --help'' for usage.'

-- o3s.json --
{
  "$schema": "./.devcontainer/o3s.schema.json",
  "stores": [],
  "hosts": [
    {"name": "example.org", "ports": [443], "by": ["registry.example.com/features/tool", "user"]}
  ]
}
