# The table lists every host with its ports, secret and who needs it, and explains the mark of a secret that waits
exec o3s firewall ls
cmp stdout want.txt
! stderr .

# With the gateway's record, every host shows the data it moved and when, and a host without data for 30 days reads as dead
exec sh -c 'now=$(date +%s); d=$HOME/.local/state/o3s/$(printf %s "$PWD" | sha256sum | cut -c1-12); mkdir -p "$d"; printf "{\"since\": %s, \"updated\": %s, \"hosts\": {\"example.com\": {\"bytes\": 1234567890, \"last_seen\": %s, \"since\": %s}, \"api.example.com\": {\"bytes\": 0, \"last_seen\": 0, \"since\": %s}}, \"blocked\": {}}" $((now-3456000)) $now $((now-300)) $((now-3456000)) $((now-3456000)) > "$d/traffic.json"'
exec o3s firewall ls
cmp stdout want-traffic.txt
! stderr .

-- o3s.json --
{
  "$schema": "./.devcontainer/o3s.schema.json",
  "stores": [],
  "hosts": [
    {"name": "example.com", "ports": [22, 443], "by": ["user"]},
    {"name": "api.example.com", "ports": [443], "secret": "EXAMPLE_TOKEN", "inject": ["header"], "by": ["registry.example.com/features/tool"]}
  ]
}
-- want.txt --
HOST             PORTS   DATA  LAST SEEN  SECRET           BY
example.com      22,443  –     –                           user
api.example.com  443     –     –          EXAMPLE_TOKEN !  registry.example.com/features/tool

! waits for its value: echo "$TOKEN" | o3s secret add <NAME>
-- want-traffic.txt --
HOST             PORTS   DATA    LAST SEEN    SECRET           BY
example.com      22,443  1.2 GB  5m ago                        user
api.example.com  443     0 B     never, dead  EXAMPLE_TOKEN !  registry.example.com/features/tool

! waits for its value: echo "$TOKEN" | o3s secret add <NAME>
dead: no data in 30 days, remove it with o3s firewall rm <host>
