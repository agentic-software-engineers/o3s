# The workspace opens in VS Code straight in the cage
mkdir home
cd home
exec o3s init
exec o3s cage ide
stdout '^Opening .*/home in the cage$'
grep '^--file-uri vscode-remote://dev-container\+[0-9a-f]+/home/ubuntu/o3s/home\.code-workspace$' $WORK/code.log

# Under WSL without the setting, o3s names the two lines to add and opens nothing
rm $WORK/code.log
env WSL_DISTRO_NAME=Ubuntu
! exec o3s cage ide
stderr '"dev\.containers\.executeInWSL": true'
stderr '"dev\.containers\.executeInWSLDistro": "Ubuntu"'
! exists $WORK/code.log

# Under WSL with the setting, VS Code opens the folder's Windows form
mkdir $WORK/appdata/Code/User
cp $WORK/settings.json $WORK/appdata/Code/User/settings.json
exec o3s cage ide
grep '^--file-uri vscode-remote://dev-container\+[0-9a-f]+/home/ubuntu/o3s/home\.code-workspace$' $WORK/code.log
grep '^-w .*/home$' $WORK/wslpath.log
env WSL_DISTRO_NAME=

# Over SSH outside a VS Code window, o3s names the Remote-SSH terminal and opens nothing
rm $WORK/code.log
env SSH_CONNECTION=$ADDRESS
! exec o3s cage ide
stderr 'Remote-SSH'
! exists $WORK/code.log

# In a Remote-SSH terminal, o3s names the variable that holds the host VS Code connected with
env VSCODE_IPC_HOOK_CLI=$WORK/vscode-ipc.sock
! exec o3s cage ide
stderr 'O3S_SSH_HOST'
! exists $WORK/code.log

# In a Remote-SSH terminal that names the host, VS Code opens the cage through it
env O3S_SSH_HOST=$SSH_HOST
exec o3s cage ide
grep '^--file-uri vscode-remote://dev-container\+[0-9a-f]+@ssh-remote\+'${SSH_HOST@R}'/home/ubuntu/o3s/home\.code-workspace$' $WORK/code.log
env SSH_CONNECTION= VSCODE_IPC_HOOK_CLI= O3S_SSH_HOST=

# Without the VS Code CLI on PATH, o3s names it
rm $WORK/.bin/code
env PATH=$WORK/.bin${:}$O3S_DIR
! exec o3s cage ide
stderr 'VS Code'

# A folder without an o3s home points at the command that starts one
cd $WORK
! exec o3s cage ide
stderr 'no o3s home'

-- settings.json --
{
  // run Docker inside WSL
  "dev.containers.executeInWSL": true,
}
