# Without a terminal or a flag, init makes the home inside its VM, the secure default, and leaves this folder an ID to find the VM by
env O3S_RELEASE_URL=file://$WORK/release
mkdir $WORK/home
cd $WORK/home
exec o3s init
exists .o3s/id
exists .o3s/ready
! exists o3s.json
grep 'tty=false --log-format=json start --name=o3s-[0-9a-f]{12} --vm-type=qemu --timeout=30m0s -$' $WORK/limactl.log
grep 'tty=false --log-format=json copy -r \S+/o3s-release o3s-[0-9a-f]{12}:/tmp/$' $WORK/limactl.log

# init names its steps in o3s's words, shows the download's progress, and keeps Lima's own records in the home's VM log
stdout '^Starting the VM o3s-[0-9a-f]{12}, its first start downloads Ubuntu and takes a few minutes$'
stdout '^Installing o3s dev in the VM$'
stdout '^Making the home in the VM$'
stdout '^The home runs in its VM o3s-[0-9a-f]{12}, step in with: o3s cage shell --vm$'
stderr '819.29 MiB / 819.29 MiB'
! stderr 'level'
exec sh -c 'cat $WORK/.local/state/o3s/*/vm.log'
stdout '"msg":"Starting the instance"'

# A machine without QEMU stops before anything downloads, naming how to install it
mv $WORK/.bin/qemu-img $WORK/qemu-img
mkdir $WORK/noqemu
cd $WORK/noqemu
! exec o3s init --yes
stderr 'this machine lacks QEMU, which runs the home''s VM on Linux, install it as in:'
! exists .o3s/id
mv $WORK/qemu-img $WORK/.bin/qemu-img

# A VM that fails to start names the host this machine could not reach and that init goes on where it stopped
exec sh -c 'printf "%s" "failed to download the image: dial tcp: lookup $HOST on 127.0.0.11:53: server misbehaving" > $WORK/lima-fails'
mkdir $WORK/offline
cd $WORK/offline
! exec o3s init --yes
stderr '^error: start the VM o3s-[0-9a-f]{12}: failed to download the image'
stderr 'this machine could not reach '${HOST@R}', check its network'
stderr 'run o3s init again, it goes on where it stopped'
! exists .o3s/ready
rm $WORK/lima-fails
cd $WORK/home
grep '^O3S_RELEASE_URL=file:///tmp/o3s-release sh /tmp/o3s-release/install.sh$' $WORK/vm.log
grep 'init --guest' $WORK/vm.log

# The VM commands find the home's VM by its ID, wherever the folder moves
exec o3s cage shell --vm -- echo inside
stdout '^inside$'
cd $WORK
mv home moved
cd moved
exec o3s cage shell --vm -- echo still
stdout '^still$'

# Release files that differ from their checksums stay out of the VM
env O3S_RELEASE_URL=file://$WORK/tampered
mkdir $WORK/other
cd $WORK/other
! exec o3s init
stderr 'differs from the release''s checksums'

# A dev build names where its release files come from
env O3S_RELEASE_URL=
! exec o3s init
stderr 'O3S_RELEASE_URL'

# The VM commands need a home with a VM
mkdir $WORK/empty
cd $WORK/empty
! exec o3s cage shell --vm -- true
stderr 'no o3s home with a VM here, run o3s init'

# --dangerously-skip-vm makes the home on this host, records the choice, and warns on every start
mkdir $WORK/process
cd $WORK/process
exec o3s init --dangerously-skip-vm
grep '"isolation": "process"' o3s.json
! exists .o3s/id
exec o3s init
stderr '^warning: the home runs without its VM, remove "isolation" from o3s.json to go back to the secure default$'

# --dangerously-skip-apparmor pairs with --dangerously-skip-vm and records the cage's run without AppArmor
mkdir $WORK/unconfined
cd $WORK/unconfined
exec o3s init --dangerously-skip-vm --dangerously-skip-apparmor
grep '"isolation": "process"' o3s.json
grep '"appArmorProfile": "unconfined"' o3s.json
stderr '^warning: the cage runs without AppArmor'

# AppArmor always runs in the home's VM, so its opt-out alone is a usage error
mkdir $WORK/alone
cd $WORK/alone
! exec o3s init --dangerously-skip-apparmor
stderr 'AppArmor always runs in the home''s VM, pair --dangerously-skip-apparmor with --dangerously-skip-vm'
stderr 'for usage'
! exists o3s.json
! exists .o3s/id

