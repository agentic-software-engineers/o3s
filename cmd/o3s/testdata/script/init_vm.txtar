# Without a terminal or a flag, init makes the home inside its VM, the secure default, and leaves this folder an ID to find the VM by
env O3S_RELEASE_URL=file://$WORK/release
mkdir $WORK/home
cd $WORK/home
exec o3s init
exists .o3s/id
! exists o3s.json
grep 'tty=false start --name=o3s-[0-9a-f]{12} --vm-type=qemu --timeout=30m0s -$' $WORK/limactl.log
grep 'tty=false copy -r \S+/o3s-release o3s-[0-9a-f]{12}:/tmp/$' $WORK/limactl.log
grep '^O3S_RELEASE_URL=file:///tmp/o3s-release sh /tmp/o3s-release/install.sh$' $WORK/vm.log
grep 'init --guest' $WORK/vm.log

# The VM commands find the home's VM by its ID, wherever the folder moves
exec o3s cage shell --vm -- echo inside
stdout '^inside$'
cd $WORK
mv home moved
cd moved
exec o3s cage shell --vm -- echo still
stdout '^still$'

# Release files that differ from their checksums stay out of the VM
env O3S_RELEASE_URL=file://$WORK/tampered
mkdir $WORK/other
cd $WORK/other
! exec o3s init
stderr 'differs from the release''s checksums'

# A dev build names where its release files come from
env O3S_RELEASE_URL=
! exec o3s init
stderr 'O3S_RELEASE_URL'

# The VM commands need a home with a VM
mkdir $WORK/empty
cd $WORK/empty
! exec o3s cage shell --vm -- true
stderr 'no o3s home with a VM here, run o3s init'

# --dangerously-skip-vm makes the home on this host, records the choice, and warns on every start
mkdir $WORK/process
cd $WORK/process
exec o3s init --dangerously-skip-vm
grep '"isolation": "process"' o3s.json
! exists .o3s/id
exec o3s init
stderr '^warning: the home runs without its VM, remove "isolation" from o3s.json to go back to the secure default$'

# --dangerously-skip-apparmor pairs with --dangerously-skip-vm and records the cage's run without AppArmor
mkdir $WORK/unconfined
cd $WORK/unconfined
exec o3s init --dangerously-skip-vm --dangerously-skip-apparmor
grep '"isolation": "process"' o3s.json
grep '"appArmorProfile": "unconfined"' o3s.json
stderr '^warning: the cage runs without AppArmor'

# AppArmor always runs in the home's VM, so its opt-out alone is a usage error
mkdir $WORK/alone
cd $WORK/alone
! exec o3s init --dangerously-skip-apparmor
stderr 'AppArmor always runs in the home''s VM, pair --dangerously-skip-apparmor with --dangerously-skip-vm'
stderr 'for usage'
! exists o3s.json
! exists .o3s/id

-- release/o3s-linux-amd64 --
#!/bin/sh
echo o3s version dev
-- release/o3s-linux-arm64 --
#!/bin/sh
echo o3s version dev
-- release/install.sh --
#!/bin/sh
echo install
