# A started host process answers once the command that started it has gone
exec o3s host start
stdout 'host process running, pid [0-9]+'
exec o3s host status
stdout 'host process running, pid [0-9]+, version '

# Starting again keeps the process that runs
exec o3s host start
stdout 'host process running'

# A second process for the same home is turned away
! exec o3s host serve --home $WORK
stderr 'another host process holds this home'

# A process that dies is started again on the next start
killhost
! exec o3s host status
exec o3s host start
stdout 'host process running, pid [0-9]+'

# A stop ends the process and frees the home
exec o3s host stop
stdout 'host process stopping'
hostgone
! exec o3s host status
stderr 'host process out of reach'

# A process started from a terminal keeps running once that terminal closes
[unix] pty o3s host start
[unix] ptywait
[unix] hoststays

-- o3s.json --
{"$schema": "./.devcontainer/o3s.schema.json", "stores": [], "hosts": []}
