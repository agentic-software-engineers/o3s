# Without a terminal or --yes, removing names what leaves and asks for --yes, the allowlist left as it was
! exec o3s firewall rm example.com
stdout '^  - example.com:22,443$'
stderr 'pass --yes to apply without a terminal'
grep '"example.com"' o3s.json

# A host the user alone needs leaves the allowlist, and a host a feature still needs stays with the feature named, both at once
exec o3s firewall rm example.com api.example.com --yes
stdout '^  ~ api.example.com stays open, still needed by registry.example.com/features/tool$'
stdout '^Removed example.com$'
stdout '^Kept api.example.com, still needed by registry.example.com/features/tool$'

# The file holds the host for the feature alone
cmp o3s.json want.json

# A host only features brought stays with them
! exec o3s firewall rm example.org --yes
stderr 'needed by features alone'

# A host the allowlist lacks is turned away
! exec o3s firewall rm absent.example --yes
stderr 'unknown host absent.example'

-- o3s.json --
{
  "$schema": "./.devcontainer/o3s.schema.json",
  "stores": [],
  "hosts": [
    {"name": "example.org", "ports": [443], "by": ["registry.example.com/features/tool"]},
    {"name": "example.com", "ports": [22, 443], "by": ["user"]},
    {"name": "api.example.com", "ports": [443], "by": ["registry.example.com/features/tool", "user"]}
  ]
}
-- want.json --
{
  "$schema": "./.devcontainer/o3s.schema.json",
  "stores": [],
  "hosts": [
    {
      "name": "api.example.com",
      "ports": [
        443
      ],
      "by": [
        "registry.example.com/features/tool"
      ]
    },
    {
      "name": "example.org",
      "ports": [
        443
      ],
      "by": [
        "registry.example.com/features/tool"
      ]
    }
  ]
}
