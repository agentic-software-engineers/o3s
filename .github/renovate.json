{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "abandonments:recommended",
    ":configMigration",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "semanticCommitScope": "deps",
  "separateMinorPatch": true,
  "pinDigests": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "automerge": true,
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["on monday"]
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "addLabels": ["security"],
    "automerge": false,
    "semanticCommitType": "fix"
  },
  "customManagers": [
    {
      "description": "Node, pinned in the workflow that lints commit messages.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/commitlint\\.yaml$/"],
      "matchStrings": ["node-version: (?<currentValue>\\S+)"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "description": "Lima, pinned in the workflow that raises a VM.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/test\\.yaml$/"],
      "matchStrings": ["LIMA_VERSION: (?<currentValue>\\S+)"],
      "depNameTemplate": "lima-vm/lima",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Bumps of the binary, the images and the stack ship to users, so they release. Anything new lands here too, which is the safer default: it shows up rather than passing unseen.",
      "matchPackageNames": ["*"],
      "semanticCommitType": "fix"
    },
    {
      "description": "Except the pipeline, which no user ever runs.",
      "matchFileNames": [".github/**"],
      "semanticCommitType": "ci"
    },
    {
      "description": "Go modules are reviewed as one batch, so the split into minor and patch is lifted for them.",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go modules"
    },
    {
      "description": "Bundle the digest refreshes that ship, which carry no version to review.",
      "matchUpdateTypes": ["pin", "pinDigest", "digest"],
      "groupName": "digests"
    },
    {
      "description": "The same for the pipeline, kept apart so each group carries one commit type.",
      "matchFileNames": [".github/**"],
      "matchUpdateTypes": ["pin", "pinDigest", "digest"],
      "groupName": "workflow digests"
    },
    {
      "description": "A digest names a build, not a release, so it has no date an age check could measure.",
      "matchUpdateTypes": ["digest"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "A tool version given as an action's input takes a version alone, so it updates without a digest pin.",
      "matchDepTypes": ["uses-with"],
      "pinDigests": false
    },
    {
      "description": "Images tracking a rolling tag do not need a digest pin.",
      "matchPackageNames": [
        "ghcr.io/hansehart/o3s-cage",
        "ghcr.io/hansehart/o3s-gateway"
      ],
      "pinDigests": false
    },
    {
      "description": "Label major updates and leave them open, so they get a deliberate review.",
      "matchUpdateTypes": ["major"],
      "addLabels": ["breaking"],
      "automerge": false
    },
    {
      "description": "Renovate updates itself through the renovate-version line, which the github-actions manager reads as an image but which takes no digest.",
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "pinDigests": false
    }
  ]
}
