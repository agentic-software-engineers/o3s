{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "abandonments:recommended",
    ":configMigration",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "timezone": "Europe/Berlin",
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "semanticCommitScope": "deps",
  "pinDigests": true,
  "minimumReleaseAge": "3 days",
  "prBodyColumns": ["Package", "Type", "Update", "Change", "Age"],
  "prBodyDefinitions": {
    "Age": "{{#if newVersion}}{{{newVersionAgeInDays}}} days{{/if}}"
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "addLabels": ["security"],
    "semanticCommitType": "fix"
  },
  "packageRules": [
    {
      "description": "Tooling bumps change how the repo is built.",
      "matchPackageNames": ["*"],
      "semanticCommitType": "build"
    },
    {
      "description": "Workflow bumps change the pipeline.",
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci"
    },
    {
      "description": "Bumps of the binary, the images and the stack ship to users, so they release.",
      "matchManagers": ["gomod", "dockerfile", "docker-compose"],
      "semanticCommitType": "fix"
    },
    {
      "description": "Images tracking a rolling tag do not need a digest pin.",
      "matchPackageNames": [
        "ghcr.io/hansehart/o3s-cage",
        "ghcr.io/hansehart/o3s-gateway"
      ],
      "pinDigests": false
    },
    {
      "description": "Label major updates so they get a deliberate review.",
      "matchUpdateTypes": ["major"],
      "addLabels": ["breaking"]
    }
  ]
}
