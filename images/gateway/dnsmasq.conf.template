# Base dnsmasq config for the egress gateway.

# Serve DNS to the cage network
listen-address=__GW_CAGE_IP__
# Also serve loopback so the container healthcheck can query dnsmasq
listen-address=127.0.0.1
# Bind the listed addresses alone
bind-interfaces

# Leave /etc/resolv.conf unread, taking upstream servers from this config alone
no-resolv
# Leave /etc/hosts unread
no-hosts
# Keep the gateway on IPv4: strip AAAA so clients receive A records alone and use IPv4
filter-AAAA
# Leave out a catch-all upstream: allow-listed domains each get their own server= line
# at start, and every other name is REFUSED and stays in the gateway, which closes
# the DNS exfiltration/tunneling channel.

# Keep unqualified (dotless) names local
domain-needed
# Keep reverse lookups for private IP ranges local
bogus-priv

# Cache up to 1000 resolved names
cache-size=1000
# Cap cached record lifetime below the ipset timeout so a re-resolve refreshes the ipset
max-cache-ttl=1800

# Log every query with its serial, so a refused name pairs with the query that asked for it
log-queries=extra
# Write that log where the gateway reads the refused names from
log-facility=__DNS_LOG_DIR__/dns.log

# generated server=/ipset= allowlist lines are appended below by entrypoint.sh
